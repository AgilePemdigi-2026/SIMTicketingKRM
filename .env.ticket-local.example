APP_NAME="SIMTicketingKRM Demo Lokal"
APP_ENV=ticket-local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
TICKET_LOCAL_ENABLED=true
DB_CONNECTION=sqlite
# Isi path absolut pada laptop masing-masing.
DB_DATABASE=/ABSOLUTE/PATH/TO/SIMTicketingKRM/database/simticketingkrm_local.sqlite
DB_URL=
DB_FOREIGN_KEYS=true
SESSION_DRIVER=file
SESSION_COOKIE=simticketingkrm_ticket_local_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
CACHE_STORE=file
CACHE_PREFIX=simticketingkrm_ticket_local
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
# Isi secara lokal; jangan commit password.
LOCAL_ADMIN_PASSWORD=
LOCAL_WISATAWAN_PASSWORD=
LOCAL_PETUGAS_PASSWORD=
